# Telegram API credentials from https://my.telegram.org (under 'API development tools')
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Your Telegram phone number with country code (e.g. +1234567890)
TG_PHONE=+1234567890

# Telegram Bot Token from @BotFather (for running bot.py)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Target Telegram Chat Folder name (case-insensitive)
FOLDER_NAME=databases

# Media and Output directories
DOWNLOAD_IMAGES=true
CONCURRENT_DOWNLOADS=8
IMAGE_DIR=downloads/images
DATABASE_DIR=database
DB_FILE=database/waifus.db
EXPORT_JSON=database/waifus.json
EXPORT_CSV=database/waifus.csv

# Session file name (will store your login session)
SESSION_NAME=waifu_session
