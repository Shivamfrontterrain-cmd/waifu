# ==============================================================================
# WAIFU CATCHER GACHA GAME BOT CONFIGURATION
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here
CATCHER_BOT_TOKEN=

# Game Economy & Spawning Settings
SPAWN_INTERVAL=30          # Number of group messages required to trigger a wild waifu spawn
SPAWN_TIMEOUT=300          # Time in seconds (5 min) before an unclaimed spawn despawns
DAILY_REWARD=500           # Coins given every 24 hours via /daily
ROLL_COST=100              # Coins required for 1 gacha summon roll (/roll)
CLAIM_REWARD=75            # Coins awarded to the player who catches a wild spawn first
INITIAL_BALANCE=250        # Starting coins for new players

# Cloud Database & GitHub Sync
GITHUB_REPO=Shivamfrontterrain-cmd/waifu
GITHUB_BRANCH=main
